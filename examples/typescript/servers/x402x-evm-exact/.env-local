PORT=4021
FACILITATOR_URL=http://localhost:4022

# CAIP-2 network id (must match facilitator & client)
EVM_NETWORK=eip155:84532

# A方案：同一 endpoint 同时支持两种签名类型（两条 requirements，通过 accepted.extra.permitType 选择）
# - eip3009：payTo 可以是 EOA 或合约
# - permit：payTo 必须是 seller7702 合约（支持 settleWithPermit）
PAY_TO=0x0000000000000000000000000000000000000000

# Asset/token used for payment requirements
ASSET_ADDRESS=0x0000000000000000000000000000000000000000
ASSET_DECIMALS=18

# Optional: improves EIP-712 signing for client/facilitator (if omitted, client/facilitator may read from chain)
ASSET_NAME=
ASSET_VERSION=


